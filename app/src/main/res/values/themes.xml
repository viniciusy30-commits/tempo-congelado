<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tempo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/vermelho</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Botao">
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/escuro</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BotaoPrimario" parent="Botao">
        <item name="android:textColor">@color/branco</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>
</resources>
